{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "declaration": true,
    "declarationDir": "./types",
    "outDir": "./esm",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "lib": ["es2018", "dom"],
    "jsx": "react"
  },
  "include": [
    "src",
    "src/@types"
  ],
  "exclude": ["node_modules", "examples"]
}